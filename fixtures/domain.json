{
  "domain": "food-parcel-supervision",
  "version": 2,
  "sample_id": "sample-007",
  "actors": [
    "快递员",
    "食品协议客户",
    "邮政管理人员",
    "市场监管人员"
  ],
  "facts": [
    "湖南省建立市场监管与邮政管理信息互通、线索互移机制",
    "首次为食品协议客户揽件须核验经营许可、登记场所与实际揽件场地，并保存资质快照与核验码",
    "外设仓库须在资质快照中登记，实际揽件地与登记场所或外设仓库不一致即为地址不符",
    "实名收寄、验视、安检结果随揽件批次记录，温控食品记录温控要求与运输交接测温",
    "快递员可作为监督员上报地址不符、包装异常和储运隐患，举报人身份另行封存",
    "邮政部门先确认寄递事实，市场监管人员再决定受理、移交、合并调查或解除",
    "线索冻结后补充材料只以追加版本保存，退回补正与跨辖区移交携带原期限和交接回执，部门切换不重新计时",
    "同一核验码扫码重试只形成一次核验，码上内容相对快照改变的立即隔离",
    "任何包裹获准进入寄递网络前，须确认当前证据上没有生效风险，未通过的食品明确停在哪个缺口"
  ],
  "constraints": [
    "客户资质快照与核验码",
    "登记场所与外设仓库",
    "扫码单次核验与篡改即隔离",
    "揽件批次与实名验视安检",
    "温控要求与运输交接",
    "快递员三类问题上报",
    "寄递事实邮政先确认",
    "受理移交合并解除四处置",
    "线索冻结与追加版本",
    "补正移交携带原期限",
    "跨辖区交接回执",
    "两部门字段最小授权",
    "举报人身份封存",
    "入网前生效风险闸门",
    "未通过缺口定位",
    "包裹编号全链路追溯"
  ],
